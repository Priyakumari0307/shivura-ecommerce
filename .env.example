# Database connection (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Session & JWT encryption secret (derive 256-bit key)
AUTH_SECRET="your-32-byte-or-longer-random-secret-key-for-session-encryption"

# Google OAuth 2.0 Credentials (Optional for local dev, used for customer OAuth)

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ==========================================
# Shivura CRM Administrator Credentials
# ==========================================
# The single authorized email address permitted to log into /CRM
ADMIN_EMAIL="admin@shivura.com"

# The bcrypt hash (cost factor 12) of the admin password.
# IMPORTANT: DO NOT enter plaintext passwords here. Bcrypt hashes are 60 characters ($2a$12$... or $2b$12$...).
# In Next.js .env files, $ characters must be escaped with \ to prevent variable expansion ($ -> \$).
# Generate locally using: node scripts/generate-admin-hash.mjs "<YourPassword>"

ADMIN_PASSWORD_HASH="\$2b\$12\$exampleBcryptPasswordHashPlaceholderHere..."

# ==========================================
# Cloudinary Media Storage (For CRM Product Images)
# ==========================================
# Required for direct server-side image uploads in Shivura CRM.
# Can be left blank initially; manual image URLs remain fully supported.

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ==========================================
# Upstash Redis REST API (Shared Rate Limiting)
# ==========================================
# Required for production distributed rate limiting across serverless instances.
UPSTASH_REDIS_REST_URL="https://your-database-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# ==========================================
# Trusted Reverse Proxy Header (Anti-IP Spoofing)
# ==========================================
# Required for production rate limiting on public endpoints (e.g. login, signup).
# In production, incoming client-supplied headers (CF-Connecting-IP, X-Real-IP,
# X-Vercel-Forwarded-For, X-Forwarded-For) are NOT trusted by default to prevent
# rate-limit bypass via IP spoofing.
#
# Set TRUSTED_PROXY_HEADER to specify the single authoritative header supplied by
# your verified edge proxy or CDN.
#
# CRITICAL DEPLOYMENT PREREQUISITE:
# Setting this variable alone DOES NOT verify proxy trust. The operator MUST ensure:
# 1. Direct access to the application origin port is blocked (e.g. firewall, AWS VPC Security
#    Group, or Cloudflare Authenticated Origin Pulls) so clients cannot bypass the proxy.
# 2. The upstream reverse proxy is configured to strip or overwrite any client-supplied value
#    for this header before forwarding the request to the application.
#
# Examples based on hosting platform:
# - Cloudflare:             TRUSTED_PROXY_HEADER="cf-connecting-ip"
# - Vercel:                 TRUSTED_PROXY_HEADER="x-vercel-forwarded-for"
# - Nginx:                  TRUSTED_PROXY_HEADER="x-real-ip" (ensure proxy_set_header X-Real-IP $remote_addr;)
# - AWS ALB / GCP LB:       TRUSTED_PROXY_HEADER="x-forwarded-for" (only if proxy strips client header)
#
# If unset in production and no platform-verified direct IP is available, security-critical
# unauthenticated endpoints (login, signup) FAIL CLOSED (HTTP 503) to prevent unthrottled attacks.
TRUSTED_PROXY_HEADER=""


# ==========================================
# Security Headers & Content Security Policy (CSP)
# ==========================================
# By default, CSP is emitted in Report-Only mode ("Content-Security-Policy-Report-Only")
# to safely monitor violations without breaking hydration or CRM previews.
# Set to "true" to strictly enforce ("Content-Security-Policy").
ENFORCE_CSP="false"
